# maqua.app — environment configuration
#
# Copy to `.env.local` for development:  cp .env.example .env.local
#
# Only NEXT_PUBLIC_APP_URL and AIR_QUALITY_PROVIDER have meaningful defaults you
# might want to change locally. Everything else is OPTIONAL: the map, the station
# list, the API and the full test suite all work with no database, no Redis, no
# AI and no email. Unconfigured subsystems report themselves disabled via
# /api/health rather than breaking the app.

# ─── Application ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://maqua.app
NODE_ENV=development

# ─── Air-quality provider ───────────────────────────────────────────────────
# eea     — the verified live source (default). ERA measurements as disseminated
#           by the European Environment Agency. See docs/DATA_SOURCE.md.
# fixture — deterministic local data replayed from real captured payloads.
#           Use for development, CI and E2E. Never used as an automatic fallback.
# era     — direct ERA integration. NOT USABLE: era.org.mt returns HTTP 403 to
#           every non-browser client, so no endpoint was ever observed and none
#           has been invented. The provider refuses to run without a verified
#           ERA_AIR_QUALITY_URL. See docs/DATA_SOURCE.md §2.
AIR_QUALITY_PROVIDER=eea

# Base URL of the EEA AQI dissemination layer. Validated against the outbound
# host allowlist, so this cannot be repointed at an arbitrary host.
EEA_AIR_QUALITY_URL=https://dis2datalake.blob.core.windows.net/airquality-derivated/AQI-noRunningMeans/

# Leave empty. Set only if you have a genuinely verified ERA endpoint.
ERA_AIR_QUALITY_URL=

# ─── Weather and environmental context ──────────────────────────────────────
# open-meteo requires no API key and is CC-BY-4.0. See docs/CONTEXT_SOURCES.md.
WEATHER_PROVIDER=open-meteo
CONTEXT_REFRESH_ENABLED=true

# ─── PostgreSQL (Neon) — OPTIONAL ───────────────────────────────────────────
# Enables historical storage, alert subscriptions and stored context events.
# Without it the app serves live readings normally; only history is unavailable.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ─── Redis (Upstash) — OPTIONAL ─────────────────────────────────────────────
# Enables distributed caching, single-flight deduplication, locks and rate
# limiting. Without it the app falls back to a per-instance in-process cache,
# which is fine locally but does not coordinate across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── OpenRouter (AI explanations) — OPTIONAL ────────────────────────────────
# All AI traffic is routed through OpenRouter. The key is server-only and is
# never exposed to the browser. Without it, "Explain this" returns a
# deterministic, non-AI explanation built from the measured data.
OPENROUTER_API_KEY=
# Models are configurable because OpenRouter availability changes over time.
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=https://maqua.app
OPENROUTER_APP_NAME=maqua.app

# ─── AI behaviour and cost controls ─────────────────────────────────────────
AI_EXPLANATIONS_ENABLED=true
AI_CONTEXT_SUMMARIES_ENABLED=true
AI_MAX_REQUESTS_PER_MINUTE=30
AI_CACHE_TTL_SECONDS=3600
AI_REQUEST_TIMEOUT_MS=15000

# ─── Resend (email alerts) — OPTIONAL ───────────────────────────────────────
# Alerts require BOTH a Resend key and ALERT_TOKEN_SECRET. Without them the
# alerts page renders an honest "not enabled on this deployment" state.
RESEND_API_KEY=
EMAIL_FROM=maqua.app <alerts@maqua.app>
EMAIL_REPLY_TO=

# Signs confirmation and unsubscribe tokens (HMAC-SHA256). Generate with:
#   openssl rand -hex 32
ALERT_TOKEN_SECRET=

# ─── Cron — OPTIONAL ────────────────────────────────────────────────────────
# Required to run scheduled refresh jobs. Cron routes return 401 without it, so
# they are never publicly invocable. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# ─── Monitoring — OPTIONAL ──────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Analytics — OPTIONAL ───────────────────────────────────────────────────
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=true
NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS_ENABLED=true
